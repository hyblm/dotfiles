#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"

if [[ -z "$mode" ]]; then
    current=$(gsettings get org.gnome.desktop.interface gtk-theme)
    if [[ "$current" == "'Colloid-Light-Compact'" ]]; then
        mode=dark
    else
        mode=light
    fi
fi

case "$mode" in
    light)
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
        gsettings set org.gnome.desktop.interface gtk-theme 'Colloid-Light-Compact'
        ;;
    dark)
        gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
        gsettings set org.gnome.desktop.interface gtk-theme 'Colloid-Dark-Compact'
        ;;
    *)
        printf 'Usage: %s [light|dark]\n' "${0##*/}" >&2
        exit 1
        ;;
esac

emacsclient --eval '(my/sync-theme-with-system)'
