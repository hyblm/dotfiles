{
  "ssh_connections": [
    {
      "host": "edhouse",
      "username": "hybl",
      "args": ["-i", ".ssh/id_ed25519ed"],
      "projects": [
        {
          "paths": ["C:\\Users\\/hybl"],
        },
        {
          "paths": [
            "C:\\Users\\hybl\\Documents\\Dev\\Projects\\sky\\microanalysis\\services\\acquisition-recorder\\/.\\",
          ],
        },
      ],
    },
  ],
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "disable_ai": false,
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "play_sound_when_agent_done": "never",
    "model_parameters": [],
  },
  "helix_mode": true,
  "vim_mode": false,
  "preferred_line_length": 100,
  "soft_wrap": "editor_width",
  "show_wrap_guides": true,
  "inlay_hints": {
    "enabled": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-sol",
        "reasoning_effort": "low"
      },
      "type": "registry"
    },
    "SymposiumDev": {
      "args": ["run"],
      "command": "/home/matyas/.cargo/bin/symposium-acp-agent",
      "env": {},
      "type": "custom",
    },
  },
  "languages": {
    "Assembly": {
      "language_servers": [],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "workspace": false,
          "command": "clippy",
          "extraArgs": [
            "--",
            "-D",
            "clippy::correctness",
            "-D",
            "clippy::suspicious",
            "-D",
            "clippy::style",
            "-D",
            "clippy::complexity",
            "-D",
            "clippy::perf",
            // "-W", "clippy::absolute_paths",
            // "-W", "clippy::excessive_nesting",
            // "-W", "clippy::too_many_lines",
            // "-W", "clippy::dbg_macro",
            // "-W", "clippy::dbg_macro",
            // "-W", "clippy::deref_by_slicing",
            // "-W", "clippy::else_if_without_else",
            // "-W", "clippy::get_unwrap",
            // "-W", "clippy::if_then_some_else_none",
            // "-W", "clippy::impl_trait_in_params",
            // "-W", "clippy::missing_asserts_for_indexing",
            // "-W", "clippy::missing_inline_in_public_items",
            // "-W", "clippy::mod_module_files",
            // "-W", "clippy::module_name_repetitions",
            // "-W", "clippy::multiple_unsafe_ops_per_block",
            // "-W", "clippy::mutex_atomic",
            // "-W", "clippy::rc_buffer"
          ],
        },
      },
    },
  },
  "buffer_font_size": 13.5,
  "gutter": {
    "line_numbers": false,
  },
  "tab_bar": {
    "show": true,
  },
  "terminal": {
    // "shell": {
      // "program": "",
    // },
    "dock": "right",
  },
  "theme": {
    "mode": "system",
    "light": "Zenbones Light",
    "dark": "Zenbones Dark",
  },
  "ui_font_size": 15.0,
  "unnecessary_code_fade": 0.4,
  "use_smartcase_search": true,
}
