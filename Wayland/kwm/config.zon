                },
            },

            // screenshot
            .{
                .keysym = "Print",
                .modifiers = .{ .mod4 = true, .shift = true },
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "sh", "-c", "mkdir -p \"$HOME/Pictures/Screenshots\" && file=\"$HOME/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png\" && grim -g \"$(slurp)\" \"$file\" && wl-copy < \"$file\"" } },
                        },
                    },
                },
            },

            // brightness keys
            .{
                .keysym = "XF86MonBrightnessUp",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .pressed = .{ .spawn = .{ .argv = .{ "brightnessctl", "--class=backlight", "set", "+10%" } }, },
                    },
                },
            },
            .{
                .keysym = "XF86MonBrightnessDown",
                .modifiers = .{},
                .event = .{
                    .click = .{
                        .pressed = .{
                            .spawn = .{ .argv = .{ "brightnessctl", "--class=backlight", "set", "10%-" } },
                        },
                    },
                },
            },
