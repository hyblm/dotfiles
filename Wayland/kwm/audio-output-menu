#!/bin/sh

set -eu

default_sink="$(pactl get-default-sink)"

sinks="$(pactl list sinks | awk -v default_sink="$default_sink" '
  function emit() {
    if (name != "") {
      printf "%s\t%s\t%s\n", name == default_sink ? "󰓃" : "󰓄", desc, name
      name=""; desc=""
    }
  }
  /^Sink #/ { emit() }
  /^[[:space:]]*Name:/ { name=$2 }
  /^[[:space:]]*Description:/ { sub(/^[[:space:]]*Description:[[:space:]]*/, ""); desc=$0 }
  /^$/ { emit() }
  END { emit() }
')"

[ -n "$sinks" ] || exit 0

pick="$(printf '%s\n' "$sinks" | awk -F '\t' '{ print $1 " " $2 }' | tofi --prompt-text 'Audio output: ')"
[ -n "$pick" ] || exit 0

sink="$(printf '%s\n' "$sinks" | awk -F '\t' -v pick="$pick" '$1 " " $2 == pick { print $3; exit }')"
[ -n "$sink" ] || exit 0

pactl set-default-sink "$sink"
pactl list short sink-inputs | while read -r input _; do
  pactl move-sink-input "$input" "$sink" 2>/dev/null || true
done

notify-send "Audio output switched" "${pick#* }" 2>/dev/null || true
