#!/bin/sh

fifo="${KWM_STATUS_FIFO:-/tmp/kwm-status}"
low_threshold="${KWM_BATTERY_LOW_THRESHOLD:-15}"
critical_threshold="${KWM_BATTERY_CRITICAL_THRESHOLD:-8}"
interval="${KWM_STATUS_INTERVAL:-15}"

[ -p "$fifo" ] || {
  rm -f "$fifo"
  mkfifo "$fifo"
}

notified_low=0
notified_critical=0

battery_path() {
  for bat in /sys/class/power_supply/BAT*; do
    [ -r "$bat/capacity" ] && {
      printf '%s\n' "$bat"
      return 0
    }
  done
  return 1
}

bluetooth_status() {
  command -v bluetoothctl >/dev/null 2>&1 || return 0

  bluetoothctl devices Connected 2>/dev/null | awk '
    /^Device / {
      name = $0
      sub(/^Device [^ ]+ /, "", name)
      if (name != "") names[++count] = name
    }
    END {
      if (count == 1) {
        printf "^#819b69ff󰂱 %s^#!", names[1]
      } else if (count > 1) {
        printf "^#819b69ff󰂱 %d devices^#!", count
      }
    }
  '
}

while true; do
  bat="$(battery_path)"

  if [ -n "$bat" ]; then
    cap="$(cat "$bat/capacity")"
    state="$(cat "$bat/status" 2>/dev/null || printf unknown)"

    case "$state" in
      Charging) icon="󰂄" ;;
      Full) icon="󰁹" ;;
      Discharging) icon="󰁹" ;;
      *) icon="󰂑" ;;
    esac

    case "$state" in
      Charging|Full)
        notified_low=0
        notified_critical=0
        color="^#819b69ff"
        ;;
      *)
        if [ "$cap" -le "$critical_threshold" ]; then
          color="^#de6e7cff"
          if [ "$notified_critical" -eq 0 ]; then
            notify-send -u critical "Battery critically low" "Battery is at ${cap}%. Plug in now." 2>/dev/null || true
            notified_critical=1
            notified_low=1
          fi
        elif [ "$cap" -le "$low_threshold" ]; then
          color="^#ebc06dff"
          if [ "$notified_low" -eq 0 ]; then
            notify-send -u normal "Battery low" "Battery is at ${cap}%." 2>/dev/null || true
            notified_low=1
          fi
        else
          color="^#819b69ff"
          notified_low=0
          notified_critical=0
        fi
        ;;
    esac

    battery="${color}${icon} ${cap}%^#!"
  else
    battery="^#de6e7cffno battery^#!"
  fi

  bluetooth="$(bluetooth_status)"
  clock="$(date '+󰸗 %a %d %b  󰥔 %H:%M')"

  if [ -n "$bluetooth" ]; then
    printf '%s  %s  %s\n' "$clock" "$bluetooth" "$battery" > "$fifo"
  else
    printf '%s  %s\n' "$clock" "$battery" > "$fifo"
  fi

  sleep "$interval"
done
