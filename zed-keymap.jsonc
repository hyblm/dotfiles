[
  {
    "context": "Workspace",
    "bindings": {
      // Neovim: <A-h/j/k/l> window navigation.
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      "alt-left": "workspace::ActivatePaneLeft",
      "alt-down": "workspace::ActivatePaneDown",
      "alt-up": "workspace::ActivatePaneUp",
      "alt-right": "workspace::ActivatePaneRight",

      // Neovim: gn/gp buffer navigation.
      "alt-shift-h": "pane::ActivatePreviousItem",
      "alt-shift-l": "pane::ActivateNextItem",
      "alt-shift-left": "pane::ActivatePreviousItem",
      "alt-shift-right": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // HELIX-compat mappings from nvim/lua/hyblm/keymaps.lua.
      "g h": "editor::MoveToBeginningOfLine",
      "g l": "editor::MoveToEndOfLine",
      "g e": "editor::MoveToEnd",
      "g n": "pane::ActivateNextItem",
      "g p": "pane::ActivatePreviousItem",
      "g a": "pane::ActivatePreviousItem",

      // Folding: nvim maps <S-Tab> to za.
      "shift-tab": "editor::ToggleFold",

      // Comments: nvim maps <leader>c and <M-c> to gcc.
      "space c": "editor::ToggleComments",
      "alt-c": "editor::ToggleComments",

      // LSP: nvim maps <leader>k/K to hover, <leader>r to rename,
      // <leader>a to code actions, and <leader>R to references.
      "space k": "editor::Hover",
      "space shift-k": "editor::Hover",
      "space r": "editor::Rename",
      "space a": "editor::ToggleCodeActions",
      "space shift-r": "editor::FindAllReferences",
    },
  },
  {
    "context": "!Terminal && vim_mode == normal",
    "bindings": {
      // fzf-lua-ish pickers from nvim/plugin/fzflua.lua.
      "space f": "file_finder::Toggle",
      "space b": "tab_switcher::Toggle",
      "space s": "outline::Toggle",
      "space shift-s": "project_symbols::Toggle",
      "space slash": "pane::DeploySearch",
      "space z": "projects::OpenRecent",
    },
  },
  {
    "context": "!Editor && !Terminal && vim_mode == normal",
    "bindings": {
      // Keep symbol search available outside editors too, but only in normal mode.
      "space s": "project_symbols::Toggle",
    },
  },
  {
    "context": "!Editor && !Terminal && vim_mode == normal",
    "unbind": {
      "space shift-s": "project_symbols::Toggle",
    },
  },
]
